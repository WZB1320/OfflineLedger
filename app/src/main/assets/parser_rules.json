    {
      "id": "wechat",
      "enabled": true,
      "packageNames": ["com.tencent.mm"],
      "titlePatterns": ["微信支付", "微信收款助手", "服务通知", "微信支付凭证"],
      "ignoreIfContains": ["红包", "零钱通收益", "收款方已收款", "已退还"],
      "amountPattern": "(?:¥|￥)\\s?([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "direction": {
        "expense": ["已支付", "支付成功", "付款成功", "支出", "向你收款", "已扣款"],
        "income": ["已收款", "收款到账", "退款", "入账", "收到", "已到账"]
      },
      "merchantPatterns": [
        "(?:向|付给|付款给)\\s*([^，,。\\s]+)",
        "(?:商户|收款方)[：:]\\s*([^，,。\\s]+)",
        "^([^，,。]+?)(?:已支付|支付成功|付款成功)"
      ],
      "minAmount": 0.01
    },
    {
      "id": "alipay",
      "enabled": true,
      "packageNames": ["com.eg.android.AlipayGphone"],
      "titlePatterns": ["支付宝", "余额宝", "花呗", "余利宝"],
      "ignoreIfContains": ["扫码领红包", "集五福", "签到", "蚂蚁森林", "蚂蚁庄园"],
      "amountPattern": "([0-9][0-9,]*(?:\\.[0-9]{1,2})?)\\s?元",
      "direction": {
        "expense": ["付款成功", "支出", "已付款", "支付成功", "扣款"],
        "income": ["收款成功", "到账", "退款", "入账", "已收款"]
      },
      "merchantPatterns": [
        "在\\s*([^，,。]+?)\\s*(?:消费|付款|支出)",
        "(?:商户|收款方|收款账户)[：:]\\s*([^，,。\\s]+)",
        "^([^，,。]+?)(?:付款成功|支付成功)"
      ],
      "minAmount": 0.01
    },
    {
      "id": "bank_sms",
      "enabled": false,
      "packageNames": ["*bank*"],
      "titlePatterns": ["银行", "储蓄卡", "信用卡", "账户"],
      "ignoreIfContains": ["验证码", "登录", "激活"],
      "amountPattern": "(?:人民币|RMB|￥|¥)\\s?([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "direction": {
        "expense": ["支出", "消费", "扣款", "付款"],
        "income": ["收入", "存入", "转入", "入账"]
      },
      "merchantPatterns": [],
      "minAmount": 0.01
    }
  ],

